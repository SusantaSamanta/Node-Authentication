# MongoDB connection
# Local (for development)
MONGO_URL=mongodb://127.0.0.1:27017

# Atlas (cloud)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=demo_database

# JWT secret (use a long random string in production)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Ethereal (for testing email only)
ETHEREAL_EMAIL=your-ethereal-email@ethereal.email
ETHEREAL_PASSWORD=your-ethereal-password

# Resend API Key (email API)
RESEND_API_KEY=re_demo_api_key

# Gmail (for sending real emails)
GMAIL_FOR_SENDMAIL=yourgmail@gmail.com
GMAIL_FOR_SENDMAIL_PW=your_app_password_here
