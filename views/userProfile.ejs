<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <title>User Profile</title>
    <style>
        * {
            padding: 0px;
            margin: 0px;
            box-sizing: border-box;
        }


        #profileContainer {
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", sans-serif;
            background: #f3f4f6;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: url('./images/background.png') no-repeat center center;
            background-size: cover;
        }

        .profile-card {
            width: 380px;
            padding-block: 60px;
            border: 1px solid #9b9b9b63;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            background: #72727296;
            backdrop-filter: blur(50px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .profile-card:hover {
            border: 1px solid #9b9b9bc2;
        }

        #profileIngContainer {
            width: 100px;
            height: 100px;
            margin-bottom: 1rem;
            border: 3px solid white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;

            img {
                height: 100%;
                width: 100%;
                object-fit: cover;
                border-radius: 50%;
            }

            div {
                height: 100%;
                width: 100%;
                border-radius: 50%;
                background: skyblue;
                display: flex;
                justify-content: center;
                align-items: center;
                color: white;
                font-size: 80px;
                font-weight: 700;
            }
        }

        .profile-card h2 {
            margin: 0.5rem 0;
            font-size: 25px;
            color: white;
        }

        .profile-card p {
            margin: 0.3rem 0;
            color: white;
            /* font-size: px; */
        }


        #verifyContainer {
            margin-top: 20px;
            color: white;

            span {
                margin-left: 8px;
                padding: 5px 12px;
                border-radius: 20px;
                background: #fff;
                color: #d62828;
                border: 1px solid #ffffff;
                font-weight: bold;
                text-decoration: none;
            }
            
            a {
                margin-left: 8px;
                padding: 5px 13px 5px 12px;
                border-radius: 20px;
                color: white;
                background: skyblue;
                cursor: pointer;
            }
        }

        #logout-btn {
            margin-top: 40px;
            padding: 10px 20px;
            background-color: #ef4444;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 500;
            transition: background 0.3s ease;
        }

        #logout-btn:hover {
            background-color: #dc2626;
        }
    </style>
</head>

<body>
    <%- include('components/naveBar') %>
        <section id="profileContainer">
            <div class="profile-card">
                <!-- <img src="https://i.pravatar.cc/100" alt="User Profile" /> -->
                <div id="profileIngContainer">
                    <!-- <img src="../images/default-profile.jpg" alt="User Profile" /> -->
                    <div id="profileText">S</div>
                </div>
                <h2 id="userName">John Doe</h2>
                <p id="userEmail">Email: johndoe@example.com</p>
                <div id="verifyContainer">
                    Email Verification :
                    <span id="verifyStatus">Verify Now</span>
                    <a href="verify-email" id="verifyLink"><i class="fa-solid fa-paper-plane"></i></a>
                </div>
                <button id="logout-btn" onclick="handleLogout()">Logout</button>
            </div>
        </section>
        <%- include('components/footer') %>
            <script>
                function handleLogout() {
                    window.location.href = '/logout';
                }
                const loadUserDetails = async () => {
                    try {
                        const response = await fetch('/profile/userData', {
                            method: 'get',
                        })
                        const userData = await response.json();
                        console.log(userData);
                        profileText.innerText = (userData.name[0]).trim().toUpperCase();
                        userName.innerText = userData.name;
                        userEmail.innerText = `Email : ${userData.email}`;
                        if (userData.isVerified) {
                            verifyStatus.innerText = 'Verified';
                            verifyStatus.style.color = 'green';
                            verifyLink.style.display = 'none';
                        } else {
                            verifyStatus.innerText = 'Not Verified';
                            verifyStatus.style.color = 'red';
                            verifyLink.style.display = 'inline-block';
                        }
                    } catch (error) {
                        console.log(error);
                    }
                }
                loadUserDetails();

            </script>
</body>

</html>