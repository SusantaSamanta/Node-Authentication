<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            padding: 0px;
            margin: 0px;
            box-sizing: border-box;
        }

        #appBody {
            min-height: 100vh;
            width: 100%;
            padding-top: 60px;
            padding-bottom: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #141517;
            font-family: Arial, Helvetica, sans-serif;
        }

        #container {
            min-height: 550px;
            max-height: max-content;
            width: 500px;
            padding: 40px;
            background-color: white;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            /* justify-content: center; */
            align-items: center;
            position: relative;
        }

        #favoriteIcon {
            color: #d5d5d5;
            font-size: 25px;
            position: absolute;
            bottom: 30px;
            right: 30px;
            cursor: pointer;
            /* border: 1px solid red; */
            z-index: 3;
            user-select: none;
        }

        #inputSection {
            height: 40px;
            width: 100%;
            border: none;
            display: grid;
            grid-template-columns: 1fr .15fr;
        }

        #inputContainer {
            height: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        #inputBox {
            width: 100%;
            height: 40px;
            padding-inline: 35px;
            font-size: 18px;
            outline: none;
            border: 1px solid gray;
            border-radius: 20px 0px 0px 20px;
        }

        #suggestionCont {
            width: 100%;
            max-height: 235px;
            height: fit-content;
            /* padding-inline: 35px; */
            padding-block: 10px;
            overflow-y: scroll;
            scrollbar-width: none;
            display: none;
            top: 42px;
            left: 0px;
            border: 1px solid rgb(205, 205, 205);
            position: absolute;
            z-index: 1;
            border-radius: 10px;
            list-style: none;
            font-size: 16px;
            backdrop-filter: blur(10px);
            background: #ffffff50;
            box-shadow: 2px 2px 10px gray;
        }

        .nameLi {
            color: red;
        }

        #suggestionCont li {
            width: 100%;
            margin-block: 2px;
            padding-inline: 35px;
            display: flex;
            align-items: center;
            cursor: pointer;
            height: 25px;
        }

        #suggestionCont li:hover {
            /* backdrop-filter: blur(10px); */
            background: #b5b5b535;
        }

        #searchBtn {
            height: 40px;
            color: #aeaeae;
            --searchBorder: 1px solid gray;
            background: #f8f8f8;
            border-top: var(--searchBorder);
            border-bottom: var(--searchBorder);
            border-right: var(--searchBorder);
            border-left: 0px;
            border-radius: 0px 20px 20px 0px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #searchBtn i {
            position: relative;
            top: 1px;
            transform: scale(1.5);
        }

        #searchBtn i:hover {
            transform: scale(1.8);
            color: #6f6f6f;
        }

        #imageSection {
            height: 250px;
            width: 100%;
            margin-top: 30px;
            margin-bottom: 25px;
            /* border: 01px solid red; */
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            position: relative;

            h1 {
                text-align: center;
                position: absolute;
                letter-spacing: 3px;
                bottom: -1%;
                margin-top: 25px;
            }
        }

        #countryFlagImage {
            max-width: 82%;
            max-height: 80%;
            box-shadow: 2px 2px 8px gray;
            border-radius: 8px;
            transition: all 0.1s ease-in;
        }

        #countryFlagImage:hover {
            transform: scale(1.01);
            box-shadow: 2px 2px 15px 6px #a0a0a0;
        }

        #countryDetails {
            min-height: 130px;
            width: 100%;
            /* margin-top: 30px; */
            padding-left: 35px;
            padding-right: 25px;
            border: 0px solid red;
            row-gap: 8px;
            column-gap: 4px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            position: relative;
            z-index: 1;

            p {
                min-height: 35px;
                min-width: fit-content;
                padding-block: 5px;
                padding-inline: 20px;
                border-radius: 18px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                background: #e0e0e0;
                letter-spacing: 1px;
                font-size: 14px;
                font-weight: 500;
                /* margin-top: 20px; */
                border: 0.5px solid white;
            }

            p:hover {
                border: 0.5px solid #bbbbbb;
            }
        }

        #coatOfArms {
            border: 0px solid red;
            max-height: 105%;
            max-width: 95%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: -1;
            filter: opacity(8%);
        }
    </style>
</head>

<body>
    <%- include("components/naveBar") %>
        <div id="appBody">

            <section id="container">
                <!-- <i id="favoriteIcon" class="fa-solid fa-heart-circle-plus"></i> -->
                <i id="favoriteIcon" class="fa-solid fa-heart"></i>
                <div id="inputSection">
                    <div id="inputContainer">
                        <input id="inputBox" placeholder="Search">
                        <ul id="suggestionCont">
                        </ul>
                    </div>
                    <button id="searchBtn">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>

                <div id="imageSection">
                    <img id="countryFlagImage" src="https://flagcdn.com/in.svg">
                    <h1 id="countryHeading">INDIA</h1>
                </div>

                <div id="countryDetails">
                    <p id="countryName">Country Name: New Delhi</p>
                    <p id="capital">Capital: New Delhi</p>
                    <p id="continent">Continent: Asia</p>
                    <p id="currency">Currency: Indian rupee - INR</p>
                    <p id="isd">ISD: +91</p>
                    <p id="cctld">ccTLD: .in</p>
                    <p id="population">Population: 12345678</p>
                    <p id="language">language: English, Hindi, Tamil</p>
                    <img id="coatOfArms" src="https://mainfacts.com/media/images/coats_of_arms/in.svg" />
                </div>


            </section>

        </div>

        <%- include("components/footer") %>

            <script>


                let inputBox = document.getElementById("inputBox");
                let suggestionCont = document.getElementById("suggestionCont");
                let searchBtn = document.getElementById('searchBtn');



                let storeName = [];


                ////////////////////     this part for retrieve all name fro the api   /////////////////////////
                let countryNameArr = [];   // [{ name: "India", alpha2Code: "IN", alpha3Code: "IND", flag: "🇮🇳" }, ...]
                let countryCodeMap = {};    // { "India": "IN", ... }  (name -> alpha2 code)

                const fetchCountryName = async () => {
                    try {
                        const res = await fetch('https://countries.dev/countries');
                        const data = await res.json();

                        countryNameArr = data.map((country) => ({
                            name: country.name,
                            alpha2Code: country.alpha2Code,
                            alpha3Code: country.alpha3Code,
                            flag: country.flag
                        }));

                        countryCodeMap = countryNameArr.reduce((map, country) => {
                            map[country.name] = country.alpha2Code;
                            return map;
                        }, {});
                    }
                    catch (err) {
                        console.log(err);
                    }
                }
                let countryListPromise = fetchCountryName();



                const searchResult = (event) => {

                    storeName = [];
                    let value = inputBox.value;
                    let liTag = '';

                    for (const country of countryNameArr)
                        if (country.name.toLowerCase().startsWith(value.toLowerCase()))
                            storeName.push(country);

                    if (storeName.length == 0) {
                        suggestionCont.style.cssText = "display: none;"
                    }
                    else {
                        suggestionCont.style.cssText = "display: block;"
                        for (const country of storeName)
                            liTag += `<li data-name="${country.name}" data-code="${country.alpha2Code}">${country.name}</li>`;

                        suggestionCont.innerHTML = liTag;
                    }

                }
                inputBox.addEventListener('input', searchResult)


                ///////////  this part for click event for all list suggestion     ////////////
                suggestionCont.addEventListener('click', (event) => {
                    const liTag = event.target.closest('li');
                    if (liTag) {
                        inputBox.value = liTag.dataset.name;
                        searchFun();
                        suggestionCont.style.display = 'none';
                    }
                });

                ///////////    this part for inputBox focus or not and the corresponding action     ///////////////
                let inputFocus = 0;
                inputBox.addEventListener('focus', () => {
                    inputFocus++;
                    if (inputFocus > 1)
                        suggestionCont.style.cssText = "display: block;"
                    inputBox.style.cssText = "border: 1px solid #1c62b9;";

                })
                inputBox.addEventListener('blur', () => {
                    setTimeout(() => {
                        suggestionCont.style.cssText = "display: none;";
                    }, 200)
                    inputBox.style.cssText = "border: 1px solid gray;"
                })






                // let  countryNameVal, capitalVla, continentVla, currencyVal, isdVal, ccTLDVal, populationVal, languagesVal, flagVal;
                let countryDetailsArr = [];
                let flagSvg;
                ////////////////     this part for receive details using inputBox.value    /////////////////

                const searchFun = async () => {
                    const nowName = inputBox.value.trim();
                    // console.log(nowName)
                    try {
                        await countryListPromise;

                        // find the alpha-2 code of the country from the fetched list
                        const fallbackCountry = countryNameArr.find(country => country.name.toLowerCase().includes(nowName.toLowerCase()));
                        const alpha2Code = countryCodeMap[nowName] || fallbackCountry?.alpha2Code;

                        if (!alpha2Code) throw new Error('Country not found');

                        const res = await fetch(`https://countries.dev/alpha/${alpha2Code}`);
                        if (!res.ok) throw new Error('Country not found');

                        const data = await res.json();
                        const currency = data.currencies?.[0];
                        const languages = (data.languages || []).map(language => language.name).join(', ');
                        const callingCodes = (data.callingCodes || []).map(code => `+${code}`).join(', ');
                        const topLevelDomain = (data.topLevelDomain || []).join(', ');
                        const coatOfArmsUrl = `https://mainfacts.com/media/images/coats_of_arms/${data.alpha2Code.toLowerCase()}.svg`;

                        countryFlagImage.src = countryDetailsArr[0] = data.flags.svg;
                        countryHeading.innerText = countryDetailsArr[1] = (data.name).toUpperCase();
                        favoriteBtnColorSet();
                        countryName.innerText = countryDetailsArr[2] = `Country Name: ${data.flag} ${data.name} (${data.cioc})`;
                        capital.innerText = countryDetailsArr[3] = `Capital: ${data.capital || 'Not Available'}`;
                        continent.innerText = countryDetailsArr[4] = `Continent: ${data.region}`;
                        currency.innerText = countryDetailsArr[5] = currency ? `Currency: ${currency.name} - ${currency.code}` : 'Currency: Not Available';
                        isd.innerText = countryDetailsArr[6] = `ISD: ${callingCodes || 'Not Available'}`;
                        cctld.innerText = countryDetailsArr[7] = `ccTLD: ${topLevelDomain || 'Not Available'}`;
                        population.innerText = countryDetailsArr[8] = `Population: ${data.population}`;
                        language.innerText = countryDetailsArr[9] = `Languages: ${languages}`;
                        countryDetailsArr[10] = coatOfArmsUrl;
                        coatOfArms.src = coatOfArmsUrl;

                        localStorage.setItem('countryDetailsArrL', JSON.stringify(countryDetailsArr));

                        countryHeadingSize();
                        // (container.offsetHeight > 650) ? container.style.cssText = 'width: 550px; padding: 30px;' : container.style.cssText = 'width: 550px; padding: 30px;';


                    }
                    catch (err) {
                        inputBox.value = '';
                        window.alert(`Don't find the Country "${nowName}"`);
                        console.log(err);
                    }
                }
                searchBtn.addEventListener('click', searchFun);


                ////////////////   Retrieve data from local storage   ///////////////

                window.onload = () => {
                    test = JSON.parse(localStorage.getItem('countryDetailsArrL'));
                    if (test != null) {
                        countryDetailsArr = test;
                        countryFlagImage.src = countryDetailsArr[0];
                        countryHeading.innerText = countryDetailsArr[1];
                        favoriteBtnColorSet();
                        countryName.innerText = countryDetailsArr[2];
                        capital.innerText = countryDetailsArr[3];
                        continent.innerText = countryDetailsArr[4];
                        currency.innerText = countryDetailsArr[5];
                        isd.innerText = countryDetailsArr[6];
                        cctld.innerText = countryDetailsArr[7];
                        population.innerText = countryDetailsArr[8];
                        language.innerText = countryDetailsArr[9];
                        (countryDetailsArr[10] != null) ? coatOfArms.src = countryDetailsArr[10] : coatOfArms.removeAttribute('src');


                        countryHeadingSize();
                        (container.offsetHeight > 650) ? container.style.cssText = 'width: 550px; padding: 30px;' : container.style.cssText = 'width: 500px; padding: 40px;';



                    }
                    else {
                        console.log('null...');
                        favoriteBtnColorSet();
                    }
                }


                ///// letter spacing fix depending on the length of the country name  /////

                const countryHeadingSize = () => {
                    if (countryDetailsArr[1].length > 15) {
                        countryHeading.style.cssText = 'letter-spacing: 0px;';
                        countryHeading.style.cssText = 'font-size: 20px;';
                    }
                    else if (countryDetailsArr[1].length > 25) {
                        countryHeading.style.cssText = 'letter-spacing: 9px';
                        countryHeading.style.cssText = 'font-size: 15px;';
                    }
                    else {
                        countryHeading.style.cssText = 'letter-spacing: 3px';
                        countryHeading.style.cssText = 'font-size: 32px;';
                    }
                }

















                const favoriteIcon = document.getElementById("favoriteIcon");
                let isFavorite = false;   // true mean the current country is already in the favorite list

                favoriteIcon.addEventListener('click', async () => {
                    if (isFavorite) {  // already in favorite list  =>  remove it
                        const response = await fetch('/countryapp/deletecountry', {
                            method: 'DELETE',
                            headers: {
                                'content-type': 'application/json',
                            },
                            body: JSON.stringify({ name: countryHeading.innerText }),
                        });
                        const data = await response.json();
                        alert(data.massage);
                        favoriteBtnColorSet();
                        return;
                    }

                    const dataToSend = setData();
                    const response = await fetch('/countryapp/savecountry', {
                        method: 'post',
                        headers: {
                            'content-type': 'application/json',
                        },
                        body: JSON.stringify(dataToSend),
                    });
                    const data = await response.json();
                    if (data.success) {
                        alert(data.massage);
                        favoriteBtnColorSet();
                    } else {
                        alert(data.massage);
                    }
                    // console.log(data);
                });

                let defaultDataToSend = {
                    name: 'INDIA',
                    flag: 'https://flagcdn.com/in.svg',
                    capital: 'Capital: New Delhi',
                    continent: 'Continent: Asia',
                    languages: 'Languages: English, Hindi, Tamil',
                }

                const setData = () => {
                    test = JSON.parse(localStorage.getItem('countryDetailsArrL'));
                    if (test != null) {
                        // console.log(test);
                        const data = {
                            name: test[1],
                            flag: test[0],
                            capital: test[3],
                            continent: test[4],
                            languages: test[9],
                        }
                        return data;
                    } else {
                        return defaultDataToSend;
                    }
                }


                const favoriteBtnColorSet = async () => {
                    console.log(countryHeading.innerText);

                    const response = await fetch('/countryapp/favoritestatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ countryName: countryHeading.innerText }),
                    });

                    const data = await response.json();

                    if (data.success) {
                        isFavorite = true;
                        favoriteIcon.style.color = 'red';
                    } else {
                        isFavorite = false;
                        // alert(data.message);
                        favoriteIcon.style.color = '#d5d5d5';
                    }

                    // console.log(data);
                };
                // favoriteBtnColorSet();  //call this function when county name change


            </script>
</body>

</html>